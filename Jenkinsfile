pipeline{
    agent { label 'amit'}
    
    stages{
       stage("Code") {
            steps {
                echo "GitHub source code checked out successfully"
            }
        }
        stage("Code Build"){
            steps{
            dockerbuild("notes-app","latest")
            }
        }
        stage("Push to DockerHub"){
            steps{
                dockerpush("dockerHubCreds","notes-app","latest")
            }
        }
        stage("Deploy"){
            steps{
                deploy()
            }
        }
        
    }
}
